{
  "name": "@goastian/astian-ui",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Design system y aplicaciones base de Astian sobre Vue 3 y Quasar.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:lib",
    "build:app": "vue-tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:visual:update": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --update-snapshots",
    "test:consumer": "node tests/consumer/verify.mjs",
    "prepack": "npm run build",
    "preview": "vite preview"
  },
  "main": "./dist-lib/astian-ui.umd.cjs",
  "module": "./dist-lib/astian-ui.js",
  "types": "./dist-lib/types/index.d.ts",
  "style": "./dist-lib/astian-ui.css",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/astian-ui.js",
      "require": "./dist-lib/astian-ui.umd.cjs"
    },
    "./style.css": "./dist-lib/astian-ui.css",
    "./tokens.css": "./src/css/tokens.css",
    "./icons/*": "./dist-lib/icons/*"
  },
  "files": [
    "dist-lib",
    "src/css/tokens.css",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "dependencies": {
    "@quasar/extras": "^1.17.0"
  },
  "peerDependencies": {
    "quasar": "^2.16.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "quasar": { "optional": true }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@quasar/vite-plugin": "^1.12.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.93.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.1.0",
    "quasar": "^2.16.0",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "keywords": ["astian", "vue", "quasar", "design-system", "components"]
}

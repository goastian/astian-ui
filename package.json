{
  "name": "@goastian/astian-ui",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "Astian design system and reference applications for Vue 3 and Quasar.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:lib",
    "build:app": "vue-tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/prepare-css.mjs && vue-tsc -p tsconfig.lib.json",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:marketing": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/marketing.spec.ts",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/ui-redesign.spec.ts",
    "test:ui-budget": "npm run build:app && node scripts/verify-ui-budget.mjs",
    "test:visual:update": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --update-snapshots",
    "test:package": "npm run build:lib && node scripts/verify-package.mjs",
    "test:consumer": "node tests/consumer/verify.mjs",
    "prepack": "npm run build",
    "preview": "vite preview"
  },
  "main": "./dist-lib/astian-ui.cjs",
  "module": "./dist-lib/astian-ui.js",
  "types": "./dist-lib/types/index.d.ts",
  "style": "./dist-lib/astian-ui.css",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/astian-ui.js",
      "require": "./dist-lib/astian-ui.cjs"
    },
    "./input": {
      "types": "./dist-lib/types/entries/input.d.ts",
      "import": "./dist-lib/input.js",
      "require": "./dist-lib/input.cjs"
    },
    "./textarea": {
      "types": "./dist-lib/types/entries/textarea.d.ts",
      "import": "./dist-lib/textarea.js",
      "require": "./dist-lib/textarea.cjs"
    },
    "./checkbox": {
      "types": "./dist-lib/types/entries/checkbox.d.ts",
      "import": "./dist-lib/checkbox.js",
      "require": "./dist-lib/checkbox.cjs"
    },
    "./button": {
      "types": "./dist-lib/types/entries/button.d.ts",
      "import": "./dist-lib/button.js",
      "require": "./dist-lib/button.cjs"
    },
    "./marketing-navigation": {
      "types": "./dist-lib/types/entries/marketing-navigation.d.ts",
      "import": "./dist-lib/marketing-navigation.js",
      "require": "./dist-lib/marketing-navigation.cjs"
    },
    "./locale-switch": {
      "types": "./dist-lib/types/entries/locale-switch.d.ts",
      "import": "./dist-lib/locale-switch.js",
      "require": "./dist-lib/locale-switch.cjs"
    },
    "./marketing-action": {
      "types": "./dist-lib/types/entries/marketing-action.d.ts",
      "import": "./dist-lib/marketing-action.js",
      "require": "./dist-lib/marketing-action.cjs"
    },
    "./cloud": {
      "types": "./dist-lib/types/cloud/index.d.ts",
      "import": "./dist-lib/cloud.js",
      "require": "./dist-lib/cloud.cjs"
    },
    "./style.css": "./dist-lib/astian-ui.css",
    "./base.css": "./dist-lib/base.css",
    "./core.css": "./dist-lib/core.css",
    "./cloud.css": "./dist-lib/cloud.css",
    "./forms.css": "./dist-lib/forms.css",
    "./marketing.css": "./dist-lib/marketing.css",
    "./fonts.css": "./dist-lib/fonts.css",
    "./tokens.css": "./dist-lib/tokens.css",
    "./icons/*": "./dist-lib/icons/*"
  },
  "files": [
    "dist-lib",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "peerDependencies": {
    "quasar": "^2.16.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "quasar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@quasar/extras": "^1.17.0",
    "@playwright/test": "^1.61.1",
    "@quasar/vite-plugin": "^1.12.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.93.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.1.0",
    "quasar": "^2.16.0",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "keywords": ["astian", "vue", "quasar", "design-system", "components"]
}

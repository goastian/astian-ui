{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-lib/types"
  },
  "include": [
    "src/index.ts",
    "src/entries/**/*.ts",
    "src/cloud/**/*.ts",
    "src/cloud/**/*.vue",
    "src/components/**/*.vue",
    "src/composables/**/*.ts",
    "src/migration/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/**/*.ts",
    "src/env.d.ts"
  ],
  "exclude": [
    "src/entries/root.ts",
    "src/pages",
    "src/layouts",
    "src/router",
    "src/main.ts",
    "src/App.vue"
  ]
}
